{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:brujula:llm-context:v1",
  "title": "LlmContextV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["composition", "rsh_band", "income_band", "preferred_format", "language", "benefits"],
  "properties": {
    "composition": {"type": "array", "maxItems": 20, "items": {"type": "object", "additionalProperties": false, "required": ["role", "age"], "properties": {"role": {"enum": ["ADULT_REFERENCE", "CHILD", "OTHER_ADULT"]}, "age": {"type": "integer", "minimum": 0, "maximum": 120}}}},
    "rsh_band": {"type": ["integer", "null"], "enum": [40, 50, 60, 70, 80, 90, 100, null]},
    "income_band": {"type": ["string", "null"], "enum": ["UNDER_110K", "110K_250K", "250K_400K", "OVER_400K", null]},
    "preferred_format": {"enum": ["TEXT", "VISUAL", "AUDIO"]},
    "language": {"type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$"},
    "benefits": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/benefit"}}
  },
  "$defs": {
    "benefit": {"type": "object", "additionalProperties": false, "required": ["benefit_id", "result", "level", "access_state", "reason_codes", "missing_codes", "amount", "source_ids"], "properties": {"benefit_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]*$", "maxLength": 80}, "result": {"enum": ["SI", "INDETERMINADO"]}, "level": {"type": ["string", "null"], "enum": ["CONFIRMADO", "PRELIMINAR", null]}, "access_state": {"enum": ["ASIGNADO", "GESTION_EN_CURSO", "GESTION_RECHAZADA", "ELEGIBLE_SIN_ASIGNACION", "SIN_CUPO", "PENDIENTE_ANTECEDENTES", "INDETERMINADO"]}, "reason_codes": {"type": "array", "maxItems": 20, "items": {"type": "string", "pattern": "^[A-Z0-9_:.-]+$"}}, "missing_codes": {"type": "array", "maxItems": 20, "items": {"type": "string", "pattern": "^[a-z0-9_.-]+$"}}, "amount": {"type": ["number", "null"], "minimum": 0}, "source_ids": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]*$"}}}}
  }
}
