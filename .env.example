# ============================================================
#  PLANTILLA DE VARIABLES DE ENTORNO
# ------------------------------------------------------------
#  COPIA este archivo como ".env" y rellena tus valores reales.
#  El archivo ".env" NUNCA se sube a GitHub (está en .gitignore).
#  Aquí solo van los NOMBRES de las variables, nunca los valores.
# ============================================================

# ---------- AWS ----------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=tu_access_key_aqui
AWS_SECRET_ACCESS_KEY=tu_secret_aqui

# ---------- IA Generativa (ej. Bedrock / OpenAI / otro) ----------
# Si usan Amazon Bedrock no hace falta API key, basta con las credenciales de AWS.
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
# OPENAI_API_KEY=sk-...   # (solo si usan OpenAI en vez de Bedrock)

# ---------- Base de datos ----------
DATABASE_URL=postgresql://usuario:password@localhost:5432/mi_base
# o para desarrollo local con SQLite:
# DATABASE_URL=sqlite:///./data/local/dev.db

# ---------- Frontend ----------
# Prefijo público: estas sí llegan al navegador, NO pongas secretos aquí.
VITE_API_URL=http://localhost:8000
