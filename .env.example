# ============================================================
#  NOMBRES DE VARIABLES DE ENTORNO (raíz del repo) — DEC-048
# ------------------------------------------------------------
#  Este archivo es REFERENCIA: solo nombres que el código lee hoy y
#  ejemplos genéricos. Nunca valores reales, credenciales, tokens,
#  números de cuenta AWS ni endpoints privados.
#  Los .env quedan fuera de git (.gitignore: .env, .env.*, *.env).
#  Datos de la demo 100% sintéticos.
#
#  TRES HECHOS QUE CONVIENE SABER ANTES DE USARLO:
#
#  1) El backend NO lee ningún archivo .env. No hay python-dotenv en
#     backend/requirements.txt ni en requirements-dev.txt: el código solo
#     consulta os.environ. Las E3_* se exportan en la misma terminal que
#     levanta uvicorn, por ejemplo en PowerShell:
#         $env:E3_MOCK = "0"
#     o se fijan en "Environment variables" de la Lambda. Crear un
#     backend/.env no hace nada por sí solo.
#
#  2) Ningún .env de este proyecto lleva secretos. Las credenciales de AWS
#     NO van en un .env: en el escritorio del evento, en CloudShell y en
#     Lambda hay rol IAM (cero credenciales que copiar). Desde un PC propio
#     se pegan credenciales temporales (con session token) en la ventana de
#     PowerShell, nunca en un archivo. Si usa un perfil de
#     ~/.aws/credentials, basta exportar AWS_PROFILE (ver más abajo).
#
#  3) Trampa de la demo: con E3_MOCK=0, si falta la SQLite e3.db o el
#     bundle de contenido C4 no carga, el backend VUELVE a mocks y solo lo
#     anota como advertencia (log "runtime_degradado_a_mock" y warning
#     RUNTIME_DEGRADADO_A_MOCK en la respuesta). La pantalla se ve igual,
#     así que hay que mirar el log antes de presentar.
# ============================================================

# ---------- Backend: modo de respuesta ----------
# E3_MOCK: si la API responde con mocks sintéticos. Default 1 (todo mock).
# Demo real: 0 (ver hecho 3: puede degradar a mock en silencio).
E3_MOCK=

# ---------- Backend: proveedor de IA generativa ----------
# E3_LLM_PROVIDER: proveedor de IA. Default stub (plantillas locales, sin AWS).
# Demo real: bedrock.
E3_LLM_PROVIDER=

# E3_BEDROCK_MODEL_ID: modelo de Bedrock.
# OJO: el default que trae el código hoy (anthropic.claude-haiku) NO EXISTE.
# Demo real: us.anthropic.claude-haiku-4-5-20251001-v1:0
E3_BEDROCK_MODEL_ID=

# E3_BEDROCK_REGION: región de Bedrock. Default us-east-1 (el evento no
# permite otra región).
E3_BEDROCK_REGION=

# ---------- Backend: Guardrails de Bedrock (nuevas) ----------
# NO son secretos: son identificadores de configuración, no credenciales.
# E3_GUARDRAIL_ID: id del Guardrail. Sin default; ejemplo genérico <guardrailId>.
E3_GUARDRAIL_ID=
# E3_GUARDRAIL_VERSION: versión publicada del Guardrail. Default 1.
E3_GUARDRAIL_VERSION=

# ---------- Backend: datos sintéticos ----------
# E3_DB_PATH: ruta de la SQLite sintética. Default backend/e3.db.
# En Lambda: /tmp/e3.db (único directorio escribible).
E3_DB_PATH=

# E3_DB_S3_BUCKET: bucket privado desde donde la Lambda baja la copia de
# snapshots/e3.db a /tmp en el arranque en frío. Sin default; solo lo usa ese
# arranque. Ejemplo genérico <bucketPrivadoSintetico>; no escriba aquí el
# nombre real del bucket.
E3_DB_S3_BUCKET=

# ---------- Backend: parámetros del motor (no tocar) ----------
# E3_FECHA_EVALUACION: fecha de evaluación de vigencia. Default 2026-10-13.
E3_FECHA_EVALUACION=
# E3_CORTE_EXCLUSIVO: corte de vigencia (semiabierto). Default 2026-10-14.
E3_CORTE_EXCLUSIVO=
# E3_SUPONER_ANTECEDENTE_EDAD: supuesto documentado del motor. Default 1.
E3_SUPONER_ANTECEDENTE_EDAD=
# E3_SUPONER_CONTROL_VIGENTE: supuesto documentado del motor. Default 1.
E3_SUPONER_CONTROL_VIGENTE=

# ---------- Backend: contenido C4 ----------
# E3_CONTENT_MANIFEST: ruta del bundle de contenido C4. No tocar en la demo.
# Default real del código: backend/fixtures/c4_mock/manifest.json (mock de
# desarrollo del Rol 2, DEC-022). El bundle autoritativo del Rol 4 es
# content/manifest.yaml y todavía necesita el adaptador YAML (DEC-022).
E3_CONTENT_MANIFEST=

# ---------- AWS (opcional, sin secretos) ----------
# Solo para quien trabaje desde un PC con un perfil ya configurado en
# ~/.aws/credentials. Con rol IAM (evento, CloudShell, Lambda) no hace falta.
# AWS_PROFILE=<nombreDePerfilLocal>

# ---------- Frontend ----------
# Las variables del frontend NO se declaran aquí: están en
# frontend/.env.example (plantilla) y se copian a frontend/.env.local
# (ignorado por git). El VITE_API_URL que traía este archivo no lo usa nadie
# (SUP-035). Recuerde que todo VITE_* se fija AL COMPILAR y queda en el JS
# público: es público por diseño y nunca admite secretos.
