# Variables del frontend (design.md §5.1). SOLO NOMBRES: no se versionan valores reales.
# Copie a frontend/.env.local (ignorado por git) para desarrollo. Ningún secreto llega al
# navegador: client ID, pool y dominio Cognito son públicos (OIDC con cliente público, sin secret).
# El VITE_API_URL del .env.example raíz no se usa (SUP-035).

# Perfil: local | demo | escala (por defecto local). Un valor desconocido bloquea la app.
VITE_PROFILE=

# true | false (por defecto false). Prohibido true en escala.
VITE_USE_MOCKS=

# Requerida sin mocks: URL absoluta terminada en /api/v1, https (http solo en loopback),
# sin credenciales, query ni hash. Relativa /api/v1 solo en local (proxy de dev).
VITE_API_BASE_URL=

# none | cognito (por defecto none). none solo con mocks o API loopback/relativa en local.
VITE_AUTH_MODE=

# Solo con VITE_AUTH_MODE=cognito (NO_VERIFICADO; recursos de Rol 2, PREG-032):
# https://cognito-idp.<region>.amazonaws.com/<poolId>
VITE_COGNITO_AUTHORITY=
# https://<dominio de inicio de sesión> (para logout)
VITE_COGNITO_DOMAIN=
# ^[a-z0-9]{1,128}$
VITE_COGNITO_CLIENT_ID=
# Lista separada por espacios (nombres exactos: PREG-032)
VITE_COGNITO_SCOPES=
# Por defecto /auth/callback
VITE_COGNITO_REDIRECT_PATH=

# Solo el literal SYNTHETIC_DEMO_NOT_A_REAL_PERSON habilita IndexedDB/cola en local/demo.
VITE_DATA_CLASSIFICATION=

# TTL de la caché Demo en horas, entero 1–72 (por defecto 12).
VITE_DEMO_CACHE_TTL_HOURS=

# --- Despliegue de referencia en AWS (NO_VERIFICADO; frontend/README.md, DEC-035) ---
# Las VITE_* se fijan AL COMPILAR y quedan en el JS público: en Amplify Hosting van en
# "Environment variables" de la app; en S3 + CloudFront, en el pipeline que ejecuta `npm run build`.
#   Ensayo Demo estático:  npm run build:demo-rehearsal (fija demo + mocks + none; sin API ni Cognito)
#   Demo con API cloud:    VITE_PROFILE=demo, VITE_USE_MOCKS=false, VITE_API_BASE_URL=https://<api>/api/v1,
#                          VITE_AUTH_MODE=cognito + VITE_COGNITO_*, VITE_DATA_CLASSIFICATION (literal sintético)
#   Escala:                VITE_PROFILE=escala, VITE_USE_MOCKS=false, VITE_API_BASE_URL=https://<api>/api/v1,
#                          VITE_AUTH_MODE=cognito + VITE_COGNITO_* (sin VITE_DATA_CLASSIFICATION: sin caché ni cola)
# Cognito solo aplica con API cloud (DEC-032). Un build demo/escala real exige el copy canónico de Rol 4.

# --- Solo build/dev (sin prefijo VITE, no llegan al navegador) ---
# true permite copy MOCK_LOCAL solo con VITE_PROFILE=demo (ensayo). Con escala el build falla.
BRUJULA_ALLOW_MOCK_COPY=
# Directorio de contenido de Rol 4 (por defecto ../content).
BRUJULA_CONTENT_DIR=
# Solo vite dev/preview: URL loopback para el proxy /api/v1 (en `npm run dev:api` por defecto http://127.0.0.1:8000).
BRUJULA_DEV_API_PROXY=
# Solo `npm run check:api`: base loopback terminada en /api/v1 (por defecto http://127.0.0.1:8000/api/v1).
BRUJULA_API_CHECK_URL=
