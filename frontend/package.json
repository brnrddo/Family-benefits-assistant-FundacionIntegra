{
  "name": "brujula-familiar-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PWA de Brújula Familiar (Rol 3). Consume solo C3; copy/C4 al compilar. Datos de demo 100 % sintéticos.",
  "engines": {
    "node": "^22.22.2 || ^24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "dev:api": "vite --mode api",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "build:e2e": "tsc -p tsconfig.app.json --noEmit && vite build --mode e2e",
    "build:demo-rehearsal": "tsc -p tsconfig.app.json --noEmit && vite build --mode demo-rehearsal",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest --run",
    "test:e2e": "playwright test",
    "gen:contract": "node scripts/gen-contract.mjs",
    "gen:icons": "node scripts/gen-icons.mjs",
    "export:i18n-catalog": "node scripts/export-i18n-catalog.mjs",
    "check:budget": "node scripts/check-budget.mjs",
    "check:api": "node scripts/check-api.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run check:budget"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.2",
    "idb": "8.0.4",
    "oidc-client-ts": "3.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "ajv": "8.20.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "msw": "3.0.3",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.4",
    "workbox-window": "7.4.1",
    "yaml": "2.9.1"
  }
}
